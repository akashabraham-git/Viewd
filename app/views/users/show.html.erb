<div style="max-width: 1000px; margin: 0 auto; padding: 20px; color: #9ab; font-family: sans-serif;">
  
  <%# PROFILE HEADER %>
  <div style="display: flex; justify-content: space-between; margin: 40px 0;">
    <div style="display: flex; gap: 20px; align-items: center;">
      <%# Profile Picture is a Member-only feature %>
      <% if @user.actable_type == 'Member' %>
        <div style="width: 80px; height: 80px; background: #2c3440; border-radius: 50%; border: 2px solid #fff; overflow: hidden;">
          <% if @user.actable&.profile_picture&.attached? %>
            <%= image_tag @user.actable.profile_picture, style: "width: 100%; height: 100%; object-fit: cover;" %>
          <% else %>
            <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #456;">👤</div>
          <% end %>
        </div>
      <% end %>

      <div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <h1 style="color: #fff; margin: 0; line-height: 1.1;"><%= @user.name %></h1>
          
          <%# Membership Badges are Member-only %>
          <% if @user.actable_type == 'Member' %>
            <% membership = @user.actable&.membership %>
            <% if membership&.active? && membership.membership_tier&.badge.present? %>
              <%= image_tag "badges/#{membership.membership_tier.badge}.jpg",
                  style: "width: 20px; height: 20px; object-fit: contain;" %>
            <% end %>
          <% end %>
        </div>

        <p style="font-size: 0.9rem; color: #00e054; margin: 2px 0 5px 0; font-family: monospace;">
          @<%= @user.username %>
        </p>
        
        <%# Subscription buttons only for the Member logged in as themselves %>
        <% if @user.actable_type == "Member" && @user == @current_user %>
          <% if @user.actable&.membership&.membership_tier&.name == "Free" %>
            <%= link_to "GET PRO", memberships_path,
              style: "font-size: 0.7rem; color: #ffd700; text-decoration: none; border: 1px solid #ffd700;
                      padding: 2px 8px; border-radius: 4px; font-weight: bold;" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# MODERATOR PANEL %>
    <% if @user.actable_type == "Moderator" %>
      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 20px;">
        <div style="background: #1a2129; border: 1px solid #ffd700; padding: 20px; border-radius: 8px;">
          <h3 style="color: #ffd700; margin-top: 0; font-size: 0.9rem; text-transform: uppercase;">Moderator Control Panel</h3>
          <div style="display: flex; gap: 15px; margin-top: 15px;">
            <%= link_to "Manage Movies", movies_path, style: "background: #ffd700; color: #000; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.8rem;" %>
            <%= link_to "Manage Cast", casts_path, style: "background: #456; color: #fff; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.8rem;" %>
            <%= link_to "Manage Genres", genres_path, style: "background: #456; color: #fff; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.8rem;" %>
          </div>
        </div>
        <% if @user == @current_user %> 
          <%= link_to "EDIT PROFILE", edit_user_path(@user), style: "background: #2c3440; color: #fff; text-decoration: none; padding: 6px 12px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid #456;" %> 
        <% end %> 
      </div>

    <% else %>
      <%# MEMBER STATS - Following/Followers only exist on the Member identity %>
      <div style="display: flex; gap: 30px; text-align: center; color: #fff; margin-top: 10px;">
        <% if @user.actable_type == 'Member' %>
          <div><strong><%= @films_count %></strong><br><small style="color:#9ab;">FILMS</small></div>
          <div><strong><%= @this_year_count %></strong><br><small style="color:#9ab;">THIS YEAR</small></div>
          
          <%= link_to user_connections_path(@user, type: 'following'), style: "color:inherit; text-decoration:none;" do %>
            <div><strong><%= @user.actable.following.count %></strong><br><small style="color:#9ab;">FOLLOWING</small></div>
          <% end %>

          <%= link_to user_connections_path(@user, type: 'followers'), style: "color:inherit; text-decoration:none;" do %>
            <div><strong><%= @user.actable.followers.count %></strong><br><small style="color:#9ab;">FOLLOWERS</small></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# MEMBER CONTENT SECTION %>
  <% if @user.actable_type == "Member" %>
    <%# ACTION BUTTONS (Follow or Edit) %> 
    <div style="display: flex; flex-direction: column; gap: 10px; align-items: flex-end; margin-bottom: 20px;"> 
      <% if @user == @current_user %> 
        <%= link_to "EDIT PROFILE", edit_user_path(@user), style: "background: #2c3440; color: #fff; text-decoration: none; padding: 6px 12px; border-radius: 3px; font-size: 0.7rem; font-weight: bold; border: 1px solid #456;" %> 
      <% else %> 
        <% if @current_user&.actable_type == "Member" %>
          <% if @current_user&.actable.following.include?(@user.actable) %> 
            <%= button_to "Unfollow", connection_path(@user.id), method: :delete, class: "btn-unfollow", style: "background: #e14f4fff; color: #000; border: none; padding: 6px 14px; border-radius: 3px; font-weight: bold; cursor: pointer;" %> 
          <% else %> 
            <%= button_to "Follow", connections_path(following_id: @user.id), method: :post, class: "btn-follow", style: "background: #00e054; color: #000; border: none; padding: 6px 14px; border-radius: 3px; font-weight: bold; cursor: pointer;" %> 
          <% end %>
        <% end %>
      <% end %> 
    </div>

    <%# NAVBAR - Links to Member-only views %>
    <div style="display:flex;gap:25px;border-bottom:1px solid #2c3440;margin-bottom:30px;
                padding-bottom:10px;font-size:0.8rem;font-weight:bold;text-transform:uppercase;">
      <%= link_to "Films", library_member_path(@user.actable), style: "color:#fff; text-decoration:none;" %>
      <%= link_to "Watchlist", watchlist_member_path(@user.actable), style: "color:#fff; text-decoration:none;" %>
      <%= link_to "Likes", likes_member_path(@user.actable), style: "color:#fff; text-decoration:none;" %>
      <%= link_to "Reviews", reviews_member_path(@user.actable), style: "color:#fff; text-decoration:none;" %>
    </div>


    <div style="display:flex;gap:40px;">
      <div style="flex:2;">
        <% if @user.actable.bio.present? %>
          <p style="margin-bottom:30px; color: #fff; line-height: 1.5;"><%= @user.actable.bio %></p>
        <% end %>

        <%# FAVORITES %>
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #456; margin-bottom: 15px;">
          <h4 style="color:#fff;font-size:0.7rem; margin: 0; padding-bottom: 5px;">FAVORITE FILMS</h4>
          <%= link_to "VIEW ALL", likes_member_path(@user.actable), style: "color:#00e054; font-size:0.7rem; text-decoration:none;" %>
        </div>

        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:40px;">
          <% @favorite_movies.each do |movie| %>
            <%= link_to movie_path(movie) do %>
              <%= image_tag movie.poster_url, style: "width:100%; border-radius:4px; border:1px solid #2c3440;" %>
            <% end %>
          <% end %>
        </div>

        <%# RECENT ACTIVITY %>
        <h4 style="display:flex;justify-content:space-between;border-bottom:1px solid #456;
                  color:#fff;font-size:0.7rem; margin-bottom: 15px; padding-bottom: 5px;">
          RECENT ACTIVITY
          <%= link_to "VIEW ALL", library_member_path(@user.actable), style: "color:#00e054; text-decoration:none;" %>
        </h4>

        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
          <% @recent_activity.each do |entry| %>
            <%= link_to movie_path(entry.movie) do %>
              <%= image_tag entry.movie.poster_url, style: "width:100%; border-radius:3px; border:1px solid #2c3440;" %>
            <% end %>
          <% end %>
        </div>
      </div>
    
      <div style="flex: 1; display: flex; flex-direction: column;">
        <%# WATCHLIST %>
        <div>
          <h4 style="display:flex;justify-content:space-between;border-bottom:1px solid #456;
                    color:#fff;font-size:0.7rem; margin-bottom: 15px; padding-bottom: 5px;">
            WATCHLIST
            <%= link_to "VIEW ALL", watchlist_member_path(@user.actable), style: "color:#00e054; text-decoration:none;" %>
          </h4>

          <div style="display:flex;position:relative;height:120px;margin-left:10px;">
            <% @watchlist.each_with_index do |entry,i| %>
              <%= link_to movie_path(entry.movie) do %>
                <%= image_tag entry.movie.poster_url,
                  style: "width:80px; height:110px; border:1px solid #000;
                        position:absolute; left:#{i*22}px; z-index:#{10-i};
                        box-shadow:-2px 0 5px rgba(0,0,0,0.5);
                        border-radius:3px;" %>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# REVIEWS %>
        <div style="margin-top: 40px;">
          <h4 style="border-bottom: 1px solid #456; color: #fff; font-size: 0.7rem; padding-bottom: 5px; margin-bottom: 15px;">REVIEWS</h4>
          <% if @top_reviews.any? %>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <% @top_reviews.each do |review| %>
                <%= link_to movie_review_path(review.movie, review), style: "text-decoration: none;" do %>
                  <div style="display: flex; gap: 10px; background: #1a2129; padding: 8px; border-radius: 4px; border: 1px solid #2c3440;">
                    <%= image_tag review.movie.poster_url, style: "width:35px; height:50px; object-fit:cover; border-radius:2px;" %>
                    <div style="flex:1;">
                      <p style="color:#fff; font-size:0.75rem; margin:0 0 4px 0; line-height:1.2;"><%= review.movie.title %></p>
                      <p style="color:#9ab; font-size:0.7rem; margin:0; line-height:1.3; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;"><%= review.content %></p>
                      <p style="color:#456; font-size:0.65rem; margin-top:4px;">♥ <%= review.likes.count %></p>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p style="color:#456; font-size:0.7rem;">No reviews yet.</p>
          <% end %>
        </div>

        <%# STATISTICS PREVIEW FOR PRO/PATRON MEMBERS %>
        <% if @user.actable_type == "Member" && @user == @current_user %>
        
          <% membership = @user.actable&.membership %>
          <% if membership&.active? && membership.membership_tier&.name&.in?(['Pro', 'Patron']) %>
            <% stats = MemberStatisticsService.new(@user.actable).call %>
            <div style="margin-top: 40px;">
              <%= link_to statistics_path, style: "text-decoration: none; color: inherit;" do %>
                <div style="border: 1px solid #00e054; padding: 12px; border-radius: 4px; cursor: pointer; transition: all 0.2s ease; background: #1a2129; hover: background: #2c3440;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h4 style="border-bottom: none; color: #fff; font-size: 0.7rem; margin: 0; padding-bottom: 0; text-transform: uppercase; letter-spacing: 0.5px;">📊 Your Stats</h4>
                    <span style="background: #00e054; color: #000; padding: 2px 6px; border-radius: 3px; font-size: 0.6rem; font-weight: bold;">PRO</span>
                  </div>
                  
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                    <div style="background: #1a2129; padding: 6px; border-radius: 3px; border-left: 2px solid #00e054;">
                      <p style="color: #678; font-size: 0.6rem; margin: 0; text-transform: uppercase; letter-spacing: 0.3px;">Films</p>
                      <p style="color: #fff; font-size: 0.95rem; margin: 2px 0 0 0; font-weight: bold;"><%= stats[:total_films] %></p>
                    </div>
                    <div style="background: #1a2129; padding: 6px; border-radius: 3px; border-left: 2px solid #00e054;">
                      <p style="color: #678; font-size: 0.6rem; margin: 0; text-transform: uppercase; letter-spacing: 0.3px;">Hours</p>
                      <p style="color: #fff; font-size: 0.95rem; margin: 2px 0 0 0; font-weight: bold;"><%= stats[:total_hours].round(0) %></p>
                    </div>
                    <div style="background: #1a2129; padding: 6px; border-radius: 3px; border-left: 2px solid #00e054;">
                      <p style="color: #678; font-size: 0.6rem; margin: 0; text-transform: uppercase; letter-spacing: 0.3px;">Avg ⭐</p>
                      <p style="color: #fff; font-size: 0.95rem; margin: 2px 0 0 0; font-weight: bold;"><%= stats[:average_rating] %></p>
                    </div>
                    <div style="background: #1a2129; padding: 6px; border-radius: 3px; border-left: 2px solid #00e054;">
                      <p style="color: #678; font-size: 0.6rem; margin: 0; text-transform: uppercase; letter-spacing: 0.3px;\">Reviews</p>
                      <p style="color: #fff; font-size: 0.95rem; margin: 2px 0 0 0; font-weight: bold;\"><%= stats[:reviewed_films] %></p>
                    </div>
                  </div>

                  <% if stats[:genre_breakdown].any? %>
                    <p style="color: #678; font-size: 0.6rem; margin: 0 0 4px 0; text-transform: uppercase; letter-spacing: 0.3px;\">Top Genres</p>
                    <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 6px;">
                      <% stats[:genre_breakdown].first(2).each do |genre, _count| %>
                        <span style="background: #00e054; color: #000; padding: 2px 6px; border-radius: 3px; font-size: 0.65rem; font-weight: bold;\"><%= genre %></span>
                      <% end %>
                    </div>
                  <% end %>

                  <p style="color: #00e054; font-size: 0.65rem; margin: 6px 0 0 0; text-align: center; font-weight: bold;\">View Full Statistics →</p>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>