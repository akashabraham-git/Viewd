<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px; color: #9ab; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2c3440; padding-bottom: 20px; margin-bottom: 40px;">
    <div>
      <h1 style="color: #fff; margin: 0; font-size: 2rem;">Your Statistics</h1>
      <p style="color: #678; margin: 5px 0 0 0; font-size: 0.9rem;">A comprehensive breakdown of your viewing habits</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <span style="background: #00e054; color: #000; padding: 6px 12px; border-radius: 4px; font-size: 0.75rem; font-weight: bold;">PRO FEATURE</span>
    </div>
  </div>

  <!-- YEAR SELECTOR -->
  <div style="margin-bottom: 40px; display: flex; gap: 10px; flex-wrap: wrap;">
    <button style="background: #00e054; color: #000; padding: 10px 20px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
      ALL TIME
    </button>
    <% @available_years.each do |year| %>
      <%= link_to year, statistics_by_year_path(year: year), 
          style: "background: #2c3440; color: #fff; padding: 10px 20px; border-radius: 4px; text-decoration: none; border: 1px solid #456;" %>
    <% end %>
  </div>

  <!-- KEY STATS CARDS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Total Films</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;"><%= @all_time_stats[:total_films] %></p>
    </div>

    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Total Hours</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;"><%= @all_time_stats[:total_hours].round(1) %></p>
    </div>

    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Average Rating</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;">★ <%= @all_time_stats[:average_rating] %></p>
    </div>

    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Reviews</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;"><%= @all_time_stats[:reviewed_films] %></p>
    </div>
  </div>

  <!-- CHARTS SECTION -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 30px; margin-bottom: 40px;">
    
    <!-- Release Year Distribution -->
    <% if @all_time_stats[:release_year_distribution].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Films by Release Year</h3>
        <canvas id="releaseYearChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

    <!-- Genre Breakdown -->
    <% if @all_time_stats[:genre_breakdown].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Top Genres</h3>
        <canvas id="genreChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

    <!-- Country Breakdown -->
    <% if @all_time_stats[:country_breakdown].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Films by Country</h3>
        <canvas id="countryChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

    <!-- Language Breakdown -->
    <% if @all_time_stats[:language_breakdown].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Films by Language</h3>
        <canvas id="languageChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

  </div>

  <!-- TOP CAST & CREW -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-bottom: 40px;">
    
    <!-- Top Actors -->
    <% if @all_time_stats[:top_actors].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Most Watched Actors</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @all_time_stats[:top_actors].each_with_index do |(actor, count), i| %>
            <li style="padding: 8px 0; border-bottom: 1px solid #2c3440; display: flex; justify-content: space-between;">
              <span style="color: #fff;"><%= i + 1 %>. <%= actor %></span>
              <span style="color: #00e054; font-weight: bold;"><%= count %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Top Directors -->
    <% if @all_time_stats[:top_directors].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Most Watched Directors</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @all_time_stats[:top_directors].each_with_index do |(director, count), i| %>
            <li style="padding: 8px 0; border-bottom: 1px solid #2c3440; display: flex; justify-content: space-between;">
              <span style="color: #fff;"><%= i + 1 %>. <%= director %></span>
              <span style="color: #00e054; font-weight: bold;"><%= count %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Release Year Chart
  <% if @all_time_stats[:release_year_distribution].any? %>
    const yearCtx = document.getElementById('releaseYearChart').getContext('2d');
    new Chart(yearCtx, {
      type: 'bar',
      data: {
        labels: <%= @all_time_stats[:release_year_distribution].keys.to_json.html_safe %>,
        datasets: [{
          label: 'Films',
          data: <%= @all_time_stats[:release_year_distribution].values.to_json.html_safe %>,
          backgroundColor: '#00e054',
          borderColor: '#00e054',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: '#2c3440' }, ticks: { color: '#9ab' } },
          x: { grid: { color: '#2c3440' }, ticks: { color: '#9ab' } }
        }
      }
    });
  <% end %>

  // Genre Chart
  <% if @all_time_stats[:genre_breakdown].any? %>
    const genreCtx = document.getElementById('genreChart').getContext('2d');
    new Chart(genreCtx, {
      type: 'bar',
      data: {
        labels: <%= @all_time_stats[:genre_breakdown].keys.to_json.html_safe %>,
        datasets: [{
          label: 'Films',
          data: <%= @all_time_stats[:genre_breakdown].values.to_json.html_safe %>,
          backgroundColor: '#00e054',
          borderColor: '#00e054',
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          x: { beginAtZero: true, grid: { color: '#2c3440' }, ticks: { color: '#9ab' } },
          y: { grid: { color: '#2c3440' }, ticks: { color: '#9ab' } }
        }
      }
    });
  <% end %>

  // Country Chart
  <% if @all_time_stats[:country_breakdown].any? %>
    const countryCtx = document.getElementById('countryChart').getContext('2d');
    new Chart(countryCtx, {
      type: 'bar',
      data: {
        labels: <%= @all_time_stats[:country_breakdown].keys.to_json.html_safe %>,
        datasets: [{
          label: 'Films',
          data: <%= @all_time_stats[:country_breakdown].values.to_json.html_safe %>,
          backgroundColor: '#00e054',
          borderColor: '#00e054',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: '#2c3440' }, ticks: { color: '#9ab' } },
          x: { grid: { color: '#2c3440' }, ticks: { color: '#9ab' } }
        }
      }
    });
  <% end %>

  // Language Chart
  <% if @all_time_stats[:language_breakdown].any? %>
    const langCtx = document.getElementById('languageChart').getContext('2d');
    new Chart(langCtx, {
      type: 'doughnut',
      data: {
        labels: <%= @all_time_stats[:language_breakdown].keys.to_json.html_safe %>,
        datasets: [{
          data: <%= @all_time_stats[:language_breakdown].values.to_json.html_safe %>,
          backgroundColor: ['#00e054', '#ff8000', '#00b4ff', '#ff4b4b', '#ffd700', '#ff69b4', '#32cd32', '#ff6347'],
          borderColor: '#1a2129',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { labels: { color: '#9ab' } } }
      }
    });
  <% end %>
</script>
