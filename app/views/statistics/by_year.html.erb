<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px; color: #9ab; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2c3440; padding-bottom: 20px; margin-bottom: 40px;">
    <div>
      <h1 style="color: #fff; margin: 0; font-size: 2rem;"><%= @year_stats[:year] %> Statistics</h1>
      <p style="color: #678; margin: 5px 0 0 0; font-size: 0.9rem;">Your viewing habits for <%= @year_stats[:year] %></p>
    </div>
    <div style="display: flex; gap: 10px;">
      <span style="background: #00e054; color: #000; padding: 6px 12px; border-radius: 4px; font-size: 0.75rem; font-weight: bold;">PRO FEATURE</span>
    </div>
  </div>

  <!-- YEAR SELECTOR -->
  <div style="margin-bottom: 40px; display: flex; gap: 10px; flex-wrap: wrap;">
    <%= link_to "ALL TIME", statistics_path, 
        style: "background: #2c3440; color: #fff; padding: 10px 20px; border-radius: 4px; text-decoration: none; border: 1px solid #456;" %>
    <% @available_years.each do |year| %>
      <%= link_to year, statistics_by_year_path(year: year), 
          style: "background: <%= year == @year_stats[:year] ? '#00e054; color: #000;' : '#2c3440; color: #fff;' %> padding: 10px 20px; border-radius: 4px; text-decoration: none; border: 1px solid #456; font-weight: bold;" %>
    <% end %>
  </div>

  <!-- KEY STATS CARDS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;">
    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Films Watched</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;"><%= @year_stats[:total_films] %></p>
    </div>

    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Total Hours</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;"><%= @year_stats[:total_hours].round(1) %></p>
    </div>

    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">Average Rating</p>
      <p style="color: #fff; font-size: 2.5rem; margin: 10px 0 0 0; font-weight: bold;">★ <%= @year_stats[:average_rating] %></p>
    </div>

    <% if @year_stats[:first_watch].present? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <p style="color: #678; font-size: 0.75rem; margin: 0; text-transform: uppercase; letter-spacing: 1px;">First Watch</p>
        <p style="color: #fff; font-size: 0.9rem; margin: 10px 0 0 0; font-weight: bold;"><%= @year_stats[:first_watch].movie.title %></p>
        <p style="color: #678; font-size: 0.8rem; margin: 5px 0 0 0;"><%= @year_stats[:first_watch].watched_date.strftime("%b %d") %></p>
      </div>
    <% end %>
  </div>

  <!-- CHARTS SECTION -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 30px; margin-bottom: 40px;">
    
    <!-- Weekly Watches -->
    <% if @year_stats[:weekly_watches].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Weekly Watches</h3>
        <canvas id="weeklyChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

    <!-- Rating Spread -->
    <% if @year_stats[:rating_spread].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Rating Distribution</h3>
        <canvas id="ratingChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

    <!-- Release Type Distribution -->
    <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
      <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Watch Types</h3>
      <canvas id="releaseTypeChart" style="max-height: 300px;"></canvas>
    </div>

    <!-- Genre Breakdown -->
    <% if @year_stats[:genre_breakdown].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Top Genres</h3>
        <canvas id="genreChart" style="max-height: 300px;"></canvas>
      </div>
    <% end %>

  </div>

  <!-- TOP CAST & CREW -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-bottom: 40px;">
    
    <!-- Top Actors -->
    <% if @year_stats[:top_actors].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Most Watched Actors</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @year_stats[:top_actors].each_with_index do |(actor, count), i| %>
            <li style="padding: 8px 0; border-bottom: 1px solid #2c3440; display: flex; justify-content: space-between;">
              <span style="color: #fff;"><%= i + 1 %>. <%= actor %></span>
              <span style="color: #00e054; font-weight: bold;"><%= count %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Top Directors -->
    <% if @year_stats[:top_directors].any? %>
      <div style="background: #1a2129; padding: 20px; border-radius: 8px; border: 1px solid #2c3440;">
        <h3 style="color: #fff; margin: 0 0 20px 0; font-size: 1rem;">Most Watched Directors</h3>
        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @year_stats[:top_directors].each_with_index do |(director, count), i| %>
            <li style="padding: 8px 0; border-bottom: 1px solid #2c3440; display: flex; justify-content: space-between;">
              <span style="color: #fff;"><%= i + 1 %>. <%= director %></span>
              <span style="color: #00e054; font-weight: bold;"><%= count %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Weekly Watches Chart
  <% if @year_stats[:weekly_watches].any? %>
    const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
    new Chart(weeklyCtx, {
      type: 'line',
      data: {
        labels: <%= @year_stats[:weekly_watches].keys.to_json.html_safe %>,
        datasets: [{
          label: 'Films',
          data: <%= @year_stats[:weekly_watches].values.to_json.html_safe %>,
          borderColor: '#00e054',
          backgroundColor: 'rgba(0, 224, 84, 0.1)',
          tension: 0.3,
          fill: true
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: '#2c3440' }, ticks: { color: '#9ab' } },
          x: { grid: { color: '#2c3440' }, ticks: { color: '#9ab' } }
        }
      }
    });
  <% end %>

  // Rating Spread Chart
  <% if @year_stats[:rating_spread].any? %>
    const ratingCtx = document.getElementById('ratingChart').getContext('2d');
    new Chart(ratingCtx, {
      type: 'bar',
      data: {
        labels: <%= @year_stats[:rating_spread].keys.map { |k| "★#{k}" }.to_json.html_safe %>,
        datasets: [{
          label: 'Count',
          data: <%= @year_stats[:rating_spread].values.to_json.html_safe %>,
          backgroundColor: '#00e054',
          borderColor: '#00e054',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: '#2c3440' }, ticks: { color: '#9ab' } },
          x: { grid: { color: '#2c3440' }, ticks: { color: '#9ab' } }
        }
      }
    });
  <% end %>

  // Release Type Distribution Chart
  const releaseTypeCtx = document.getElementById('releaseTypeChart').getContext('2d');
  new Chart(releaseTypeCtx, {
    type: 'doughnut',
    data: {
      labels: ['Releases', 'Reviews', 'Rewatches'],
      datasets: [{
        data: [
          <%= @year_stats[:release_type_distribution][:releases] %>,
          <%= @year_stats[:release_type_distribution][:reviewed] %>,
          <%= @year_stats[:release_type_distribution][:rewatches] %>
        ],
        backgroundColor: ['#00e054', '#ff8000', '#00b4ff'],
        borderColor: '#1a2129',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { labels: { color: '#9ab' } } }
    }
  });

  // Genre Chart
  <% if @year_stats[:genre_breakdown].any? %>
    const genreCtx = document.getElementById('genreChart').getContext('2d');
    new Chart(genreCtx, {
      type: 'bar',
      data: {
        labels: <%= @year_stats[:genre_breakdown].keys.to_json.html_safe %>,
        datasets: [{
          label: 'Films',
          data: <%= @year_stats[:genre_breakdown].values.to_json.html_safe %>,
          backgroundColor: '#00e054',
          borderColor: '#00e054',
          borderWidth: 1
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
          x: { beginAtZero: true, grid: { color: '#2c3440' }, ticks: { color: '#9ab' } },
          y: { grid: { color: '#2c3440' }, ticks: { color: '#9ab' } }
        }
      }
    });
  <% end %>
</script>
