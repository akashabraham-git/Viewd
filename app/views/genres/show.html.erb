<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px; font-family: sans-serif;">
  
  <header style="border-bottom: 1px solid #2c3440; padding-bottom: 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h1 style="color: #fff; margin: 0; font-size: 2rem;"><%= @genre.name %> Movies</h1>
      <p style="color: #678; margin-top: 5px;">Showing all films categorized under <%= @genre.name %>.</p>
    </div>
    <%= link_to "BACK TO ALL MOVIES", movies_path, style: "color: #00e054; text-decoration: none; font-size: 0.8rem; font-weight: bold;" %>
  </header>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 30px;">
    <% if @movies.any? %>
      <% @movies.each do |movie| %>
        <%= link_to movie_path(movie), style: "text-decoration: none; color: inherit;" do %>
          <div style="display: flex; flex-direction: column;">
            <div style="aspect-ratio: 2/3; overflow: hidden; border-radius: 4px; border: 1px solid #2c3440; transition: border 0.2s;">
              <% if movie.poster_url.present? %>
                <%= image_tag movie.poster_url, style: "width: 100%; height: 100%; object-fit: cover" %>
              <% else %>
                <div style="width: 100%; height: 100%; background: #2c3440; display: flex; align-items: center; justify-content: center; color: #456;">No Poster</div>
              <% end %>
            </div>
            <h3 style="color: #fff; font-size: 0.9rem; margin-top: 10px; font-weight: normal;"><%= movie.title %></h3>
            <span style="color: #678; font-size: 0.8rem;"><%= movie.release_date&.year %></span>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p style="color: #678; grid-column: 1 / -1; text-align: center; padding: 50px;">No movies found in this genre yet.</p>
    <% end %>
  </div>
</div>