<%= form_with(model: cast, local: true) do |f| %>
  <div style="background: #1a2129; padding: 30px; border-radius: 8px; border: 1px solid #2c3440;">
    
    <% if cast.errors.any? %>
      <div style="color: #ff4b4b; margin-bottom: 20px; font-size: 0.8rem;">
        <%= cast.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div style="margin-bottom: 20px;">
      <%= f.label :name, style: "display: block; color: #678; font-size: 0.7rem; margin-bottom: 8px; text-transform: uppercase;" %>
      <%= f.text_field :name, placeholder: "e.g. Christopher Nolan", style: "width: 100%; background: #14181c; color: #fff; border: 1px solid #456; padding: 12px; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= f.label :pic, "Profile Image URL", style: "display: block; color: #678; font-size: 0.7rem; margin-bottom: 8px; text-transform: uppercase;" %>
      <%= f.text_field :pic, placeholder: "https://...", style: "width: 100%; background: #14181c; color: #fff; border: 1px solid #456; padding: 12px; border-radius: 4px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 30px;">
      <%= f.label :bio, style: "display: block; color: #678; font-size: 0.7rem; margin-bottom: 8px; text-transform: uppercase;" %>
      <%= f.text_area :bio, placeholder: "Brief biography...", style: "width: 100%; height: 150px; background: #14181c; color: #fff; border: 1px solid #456; padding: 12px; border-radius: 4px; resize: none; box-sizing: border-box;" %>
    </div>

    <div style="display: flex; gap: 15px; align-items: center;">
      <%= f.submit (cast.new_record? ? "CREATE PERSON" : "UPDATE PROFILE"), 
          style: "background: #00e054; color: #000; border: none; padding: 12px 30px; font-weight: bold; border-radius: 3px; cursor: pointer; font-size: 0.8rem;" %>
      <%= link_to "CANCEL", casts_path, style: "color: #9ab; text-decoration: none; font-size: 0.8rem;" %>
    </div>
  </div>
<% end %>