<div style="max-width: 600px; margin: 60px auto; font-family: sans-serif;">
  <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
    <% if @cast_member.pic.present? %>
      <%= image_tag @cast_member.pic, style: "width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #00e054;" %>
    <% end %>
    <h2 style="color: #fff; margin: 0;">Edit Profile: <%= @cast_member.name %></h2>
  </div>

  <%= render 'form', cast: @cast_member %>
</div>