<%# 1. Fetch the entry safely via the Member identity %>
<% entry = (user&.actable_type == 'Member') ? user.actable.library_entries.find_by(movie: movie) : nil %>

<div id="watchlist-section-<%= movie.id %>">
  <% if user&.actable_type == 'Member' %>
    
    <%# Using the toggle path: one route for both adding and removing %>
    <%= button_to toggle_watchlist_movie_path(movie), 
                  method: :post,
                  style: "background: transparent; border: none; padding: 0; cursor: pointer; color: inherit; font: inherit; outline: none;" do %>
      
      <%= entry&.in_watchlist ? "✓ In Watchlist" : "+ Watchlist" %>
      
    <% end %>

  <% else %>
    <span style="color: #678; font-size: 0.65rem; text-transform: uppercase;">Member Feature</span>
  <% end %>
</div>