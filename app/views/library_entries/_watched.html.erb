<%# Fetch entry via Member identity (actable) %>
<% entry = (user&.actable_type == 'Member') ? user.actable.library_entries.find_by(movie: movie) : nil %>
<% watched = entry&.watched_date.present? %>

<div id="watched-section-<%= movie.id %>">
  <% if user&.actable_type == 'Member' %>
    
    <%= button_to toggle_watched_movie_path(movie), 
        method: :post do %>
                
      <%= watched ? "★ Watched" : "Mark as Watched" %>
      
    <% end %>

  <% else %>
    <span style="color: #456; font-size: 0.7rem; font-style: italic;">Log unavailable</span>
  <% end %>
</div>