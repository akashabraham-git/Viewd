<%# Fetch entry via member_id since we switched from user_id %>
<% entry = nil %>
<% if user&.actable_type == 'Member' %>
  <% entry = user.actable.library_entries.find_by(movie: movie) %>
<% end %>

<div id="watched-section-<%= movie.id %>">
  <% if entry&.watched_date %>
    <div style="display: flex; align-items: center; gap: 8px; color: #00e054; font-size: 0.75rem; font-weight: bold;">
      <span style="font-size: 1.2rem;">✓</span> WATCHED
    </div>
  <% elsif user&.actable_type == 'Member' %>
    <%# Use the nested helper: movie_library_entries_path(movie_object) %>
    <%= button_to "LOG", movie_library_entries_path(movie), 
        method: :post,
        params: { watched: true },
        style: "background: #456; color: #fff; border: none; padding: 5px 15px; border-radius: 3px; font-weight: bold; cursor: pointer; font-size: 0.7rem;" %>
  <% else %>
    <%# Non-members (Moderators) shouldn't see a log button %>
    <span style="color: #456; font-size: 0.7rem; font-style: italic;">Log unavailable</span>
  <% end %>
</div>