<div style="max-width: 700px; margin: 0 auto; padding: 40px 20px; color: #9ab;">
  <h2 style="color: #fff; border-bottom: 1px solid #2c3440; padding-bottom: 15px; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1px;">
    <%= @user.name %>: <%= @type.upcase %>
  </h2>

  <div style="margin-top: 10px;">
    <% if @users.any? %>
      <% @users.each do |member| %>
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 15px 0; border-bottom: 1px solid #232a33;">
          <div style="display: flex; align-items: center; gap: 15px;">
            <%# Updated Connection Avatar Logic %>
            <div style="width: 45px; height: 45px; background: #2c3440; border-radius: 50%; border: 1px solid #456; overflow: hidden;">
              <% if member.profile_picture&.attached? %>
                <%= image_tag member.profile_picture, style: "width: 100%; height: 100%; object-fit: cover;" %>
              <% else %>
                <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #456;">👤</div>
              <% end %>
            </div>
            <%= link_to member.user.name, user_path(member.user), style: "color: #fff; text-decoration: none; font-weight: bold; font-size: 1.1rem;" %>
          </div>

          <% unless member == @current_user&.actable %>
            <% unless @current_user.nil? %>
              <% if @current_user&.actable.following.include?(member) %>  
                <%= button_to "Unfollow", connection_path(member.user.id), method: :delete, style: "background: transparent; color: #678; border: 1px solid #456; padding: 5px 12px; border-radius: 3px; cursor: pointer;" %>
              <% else %>
                <%= button_to "Follow", connections_path(following_id: member.user.id), method: :post, style: "background: #00e054; color: #000; border: none; padding: 6px 14px; border-radius: 3px; font-weight: bold; cursor: pointer;" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p style="padding: 40px 0; text-align: center; color: #456;">No one here yet.</p>
    <% end %>
  </div>
  
  <%= link_to "← Back to Profile", user_path(@user), style: "display: inline-block; margin-top: 30px; color: #678; text-decoration: none; font-size: 0.8rem;" %>
</div>