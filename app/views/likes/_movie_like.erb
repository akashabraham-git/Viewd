<%# Access likes via the Member identity since user_id was replaced by member_id %>
<% liked = false %>
<% if user&.actable_type == 'Member' %>
  <% liked = user.actable.likes.exists?(likeable: movie) %>
<% end %>

<div id="like-section-<%= movie.id %>">
  <% if liked %>
    <%= button_to movie_toggle_like_path(movie), method: :post, remote: true, style: "background: none; border: none; cursor: pointer;" do %>
      <span style="color: #ff8000; font-size: 1.5rem;">♥</span>
    <% end %>
  <% elsif user&.actable_type == 'Member' %>
    <%= button_to movie_toggle_like_path(movie), method: :post, remote: true, style: "background: none; border: none; cursor: pointer;" do %>
      <span style="color: #456; font-size: 1.5rem;">♡</span>
    <% end %>
  <% else %>
     <span style="color: #2c3440; font-size: 1.5rem;">♡</span>
  <% end %>
</div>