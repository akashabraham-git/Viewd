<% liked = (user&.actable_type == 'Member') && user.actable.likes.exists?(likeable: movie) %>

<div id="like-section-<%= movie.id %>">
  <% if user&.actable_type == 'Member' %>
    
    <%= button_to toggle_movie_like_movie_path(movie), 
                  method: :post, 
                  remote: true, 
                  style: "background: none; border: none; cursor: pointer; padding: 0;" do %>
      <%# Toggle icon and color based on 'liked' variable %>
      <span style="color: <%= liked ? '#ff8000' : '#456' %>; font-size: 1.5rem;">
        <%= liked ? '♥' : '♡' %>
      </span>
    <% end %>

  <% else %>
    <%# Non-member/Logged out view %>
    <span style="color: #2c3440; font-size: 1.5rem; cursor: default;">♡</span>
  <% end %>
</div>